{
  "name": "jinshuju-open-api-docs",
  "version": "1.0.0",
  "private": true,
  "description": "金数据开放平台 API 交互式文档站（Apifox 风格三栏 + 在线调试）",
  "type": "module",
  "scripts": {
    "data": "node --experimental-strip-types scripts/build-data.mjs",
    "build": "npm run data && node scripts/build-static.mjs",
    "preview": "npm run build && npx --yes serve dist",
    "deploy:wdl": "npm run data && wdl deploy ."
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@wdl-dev/cli": "^1.6.0"
  }
}
